{
  "manifest_version": 3,
  "name": "Snap Vanish - Thanos dust for video calls",
  "version": "1.1.0",
  "description": "Snap your fingers in a browser video call to dissolve into dust. Snap again to reassemble. Works on supported call sites you enable (Zoom, Google Meet, Proton Meet, Teams, Discord, Webex, Jitsi, Whereby).",
  "browser_specific_settings": {
    "gecko": {
      "id": "snapvanish@warquah.dev",
      "strict_min_version": "109.0"
    }
  },
  "host_permissions": [
    "*://*.zoom.us/*",
    "*://meet.google.com/*",
    "*://meet.proton.me/*",
    "*://teams.microsoft.com/*",
    "*://teams.live.com/*",
    "*://discord.com/*",
    "*://*.webex.com/*",
    "*://meet.jit.si/*",
    "*://*.whereby.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.zoom.us/*",
        "*://meet.google.com/*",
        "*://meet.proton.me/*",
        "*://teams.microsoft.com/*",
        "*://teams.live.com/*",
        "*://discord.com/*",
        "*://*.webex.com/*",
        "*://meet.jit.si/*",
        "*://*.whereby.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.zoom.us/*",
        "*://meet.google.com/*",
        "*://meet.proton.me/*",
        "*://teams.microsoft.com/*",
        "*://teams.live.com/*",
        "*://discord.com/*",
        "*://*.webex.com/*",
        "*://meet.jit.si/*",
        "*://*.whereby.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "tf.min.js",
        "body-pix.min.js",
        "snap-detector.js",
        "model-stride16.json",
        "group1-shard1of1.bin"
      ],
      "matches": [
        "*://*.zoom.us/*",
        "*://meet.google.com/*",
        "*://meet.proton.me/*",
        "*://teams.microsoft.com/*",
        "*://teams.live.com/*",
        "*://discord.com/*",
        "*://*.webex.com/*",
        "*://meet.jit.si/*",
        "*://*.whereby.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Snap Vanish"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "storage"
  ]
}
